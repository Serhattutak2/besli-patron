{
  "expo": {
    "name": "Saha Bizim",
    "slug": "abacusai-mobile-apps",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "abacusai1789939013",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sardurtechnologies.beslipatron",
      "buildNumber": "22",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C1424",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sardurtechnologies.beslipatron",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Saha Bizim",
      "backgroundColor": "#0C1424"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4873666267587702~4040896289",
          "iosAppId": "ca-app-pub-4873666267587702~1281504021"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Bu izin, sana daha alakalı reklamlar göstermek için kullanılır. İzin vermesen de oyun aynen çalışır."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C1424"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efb521a5-73f6-4cbd-8357-025593741ce6"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1424"
    }
  }
}